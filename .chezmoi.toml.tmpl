{{- $name := promptStringOnce . "name" "Full name" -}}
{{- $email := promptStringOnce . "email" "Email address" -}}
{{- $signingKey := promptStringOnce . "signingKey" "SSH signing key (paste full public key, e.g. ssh-ed25519 AAAA...)" -}}
{{- $machineType := promptStringOnce . "machineType" "Machine type (air / pro / mini)" -}}

[data]
    name        = {{ $name | quote }}
    email       = {{ $email | quote }}
    signingKey  = {{ $signingKey | quote }}
    machineType = {{ $machineType | quote }}
