#!/usr/bin/env bash
{{ if ne .chezmoi.os "darwin" }}
exit 0
{{ end }}

set -euo pipefail

# Re-render this script when scripts/osx-tweaks changes.
# osx_tweaks_sha256={{ include "scripts/osx-tweaks" | sha256sum }}

tmp_script="$(mktemp "${TMPDIR:-/tmp}/chezmoi-osx-tweaks.XXXXXX")"
trap 'rm -f "$tmp_script"' EXIT

cat > "$tmp_script" <<'EOF'
{{ include "scripts/osx-tweaks" }}
EOF

chmod +x "$tmp_script"
"$tmp_script"
