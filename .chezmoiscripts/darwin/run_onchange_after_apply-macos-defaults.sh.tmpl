#!/usr/bin/env bash
{{ if ne .chezmoi.os "darwin" }}exit 0{{ end }}

set -euo pipefail

# Re-render this script when scripts/osx-tweaks changes.
# osx_tweaks_sha256={{ include "scripts/osx-tweaks" | sha256sum }}

tweaks_script="$(chezmoi source-path scripts/osx-tweaks)"

if [[ ! -x "$tweaks_script" ]]; then
  chmod +x "$tweaks_script"
fi

"$tweaks_script"
