#!/usr/bin/env bash
{{ if ne .chezmoi.os "darwin" }}exit 0{{ end }}

set -euo pipefail

# Re-render this script when Brewfile changes.
# brewfile_template_sha256={{ include "Brewfile" | sha256sum }}

if ! command -v brew >/dev/null 2>&1; then
  echo "Homebrew is not installed yet, skipping Brewfile install."
  exit 0
fi

source_brewfile="$(chezmoi source-path Brewfile)"
tmp_brewfile="$(mktemp "${TMPDIR:-/tmp}/chezmoi-brewfile.XXXXXX")"
trap 'rm -f "$tmp_brewfile"' EXIT

chezmoi execute-template < "$source_brewfile" > "$tmp_brewfile"

if brew bundle check --no-upgrade --file "$tmp_brewfile" >/dev/null; then
  echo "Homebrew bundle is already satisfied."
  exit 0
fi

brew bundle install --no-upgrade --file "$tmp_brewfile"
