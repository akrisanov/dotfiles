#!/usr/bin/env bash
{{- $machineRole := (get . "machineRole" | default "personal") -}}
{{- $installWorkTools := (get . "installWorkTools" | default false) -}}

set -euo pipefail

# Re-render this script when extension lists change.
# extensions_common_sha256={{ include "vscode/extensions.common.txt" | sha256sum }}
# extensions_personal_sha256={{ include "vscode/extensions.personal.txt" | sha256sum }}
# extensions_work_sha256={{ include "vscode/extensions.work.txt" | sha256sum }}

if ! command -v code >/dev/null 2>&1; then
  echo "VS Code CLI not found, skipping extension install."
  exit 0
fi

declare -a extension_files=(
  "$(chezmoi source-path vscode/extensions.common.txt)"
)

{{ if eq $machineRole "personal" -}}
extension_files+=("$(chezmoi source-path vscode/extensions.personal.txt)")
{{ end -}}
{{ if or (eq $machineRole "work") $installWorkTools -}}
extension_files+=("$(chezmoi source-path vscode/extensions.work.txt)")
{{ end -}}

installed_extensions="$(code --list-extensions)"
declare -a desired_extensions=()

for list_file in "${extension_files[@]}"; do
  while IFS= read -r line; do
    extension="$(printf '%s' "$line" | sed 's/[[:space:]]*#.*$//' | xargs)"
    [[ -z "$extension" ]] && continue
    desired_extensions+=("$extension")
  done < "$list_file"
done

failed=0
for extension in "${desired_extensions[@]}"; do
  if grep -qxF "$extension" <<< "$installed_extensions"; then
    continue
  fi

  if ! code --install-extension "$extension" --force; then
    echo "Failed to install VS Code extension: $extension"
    failed=1
  fi
done

if [[ "$failed" -ne 0 ]]; then
  exit 1
fi
