# Local/private SSH hosts.
# This file is managed by chezmoi with 0600 permissions and is only created
# if ~/.ssh/config.local does not already exist.

# Example work host:
# Host work-server
#   HostName 10.0.0.1
#   Port 22
#   User yourname
#   IdentityFile ~/.ssh/work

# Example VPN:
# Host vpn
#   HostName <ip>
#   Port <port>
#   User <user>
#   IdentityFile ~/.ssh/vpn
