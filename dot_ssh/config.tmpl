# Personal hosts (work servers, VPN, local machines).
# This file is NOT committed to dotfiles.
# Bootstrap template: create_private_dot_ssh/config.local.tmpl.
Include ~/.ssh/config.local

# ── Global defaults ────────────────────────────────────────────────────────────

Host *
  AddKeysToAgent yes
{{- if eq .chezmoi.os "darwin" }}
  UseKeychain yes
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- end }}
  ServerAliveInterval 60
  ServerAliveCountMax 3

# ── GitHub ─────────────────────────────────────────────────────────────────────

Host github.com
  HostName github.com
  User git

# ── OrbStack (macOS) ───────────────────────────────────────────────────────────
{{ if eq .chezmoi.os "darwin" -}}
Include ~/.orbstack/ssh/config
{{ end -}}
