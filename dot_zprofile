#
# Login shell initialization — runs once per login session.

# ── Locale ────────────────────────────────────────────────────────────────────
[[ -z "$LANG" ]]   && export LANG='en_US.UTF-8'
[[ -z "$LC_ALL" ]] && export LC_ALL='en_US.UTF-8'

# ── Default programs ──────────────────────────────────────────────────────────
export EDITOR='hx'
export VISUAL='hx'
export PAGER='less'
export LESS='-F -g -i -M -R -S -w -X -z-4'

[[ "$OSTYPE" == darwin* ]] && export BROWSER='open'

# ── Homebrew ──────────────────────────────────────────────────────────────────
# Detect brew location: Apple Silicon → Intel → Linux (system) → Linux (user)
if   [[ -x /opt/homebrew/bin/brew ]];              then eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]];                 then eval "$(/usr/local/bin/brew shellenv)"
elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [[ -x "$HOME/.linuxbrew/bin/brew" ]];         then eval "$("$HOME/.linuxbrew/bin/brew" shellenv)"
fi

# ── Path deduplication ────────────────────────────────────────────────────────
typeset -gU cdpath fpath mailpath path
