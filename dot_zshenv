#
# Defines environment variables.
# Sourced for every zsh invocation — ensures zprofile runs in non-login shells
# (e.g. subshells, editor terminals that don't start as login shells).
if [[ "$SHLVL" -eq 1 && ! -o LOGIN && -s "${ZDOTDIR:-$HOME}/.zprofile" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprofile"
fi
